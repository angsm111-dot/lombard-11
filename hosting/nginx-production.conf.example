# JDM/BOK: merge into ONLY the existing lombard11.pl vhost, not a new TLS server.
# This is not uploaded to the public root and is not installed automatically.
# Replace __CONFIRMED_ROOT__ after checking realpath and the panel domain mapping.
root __CONFIRMED_ROOT__/current;
index index.html;
autoindex off;
set $l11_maintenance 0;
if (-f __CONFIRMED_ROOT__/maintenance.enabled) { set $l11_maintenance 1; }
if ($uri = /deployment.json) { set $l11_maintenance 0; }
if ($uri = /maintenance.html) { set $l11_maintenance 0; }
if ($l11_maintenance = 1) { return 503; }
error_page 503 /maintenance.html;
error_page 404 /404.html;
add_header Cache-Control "no-store, max-age=0" always;
add_header Retry-After "300" always;
location / { try_files $uri $uri/ =404; }
location = /deployment.json { try_files $uri =404; }
location ~ /\. { deny all; }
location ~ \.php$ { return 404; }
# Add reviewed legacy redirects from hosting/legacy-url-inventory.csv.
# Redirect www/HTTPS using JDM's domain panel; preserve existing TLS configuration.
